# Environment variables for TS4
#
# Copy this file to `.env.local` (git-ignored).
#
# OUTLETS: each outlet has its own Google Sheet + Apps Script Web App. The
# client only needs each outlet's /exec URL. You normally DON'T set anything here:
#   - Local dev: `npm run dev` reads outlets.local.json automatically
#     (copy outlets.example.json; `npm run deploy` fills in deploymentIds).
#   - GitHub Pages: repository secret VITE_OUTLETS (`npm run outlets:secret`).
# Manual override (JSON array):
# VITE_OUTLETS=[{"name":"TS1","url":"https://script.google.com/macros/s/XXXX/exec"}]

# Legacy single-backend fallback, used only when VITE_OUTLETS is empty.
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional: client request timeout in milliseconds (default 45000 — some
# Apps Script reports do a full-sheet scan and can take 20–30 s cold).
# VITE_API_TIMEOUT_MS=45000

# Optional: business timezone (IANA name) used for "today", date pickers and
# all displayed timestamps. Must match appsscript.json "timeZone". Default Asia/Jakarta.
# VITE_BUSINESS_TZ=Asia/Jakarta

# ── LEGACY (not used by the current architecture) ──────────────────────────
# These belong to the deprecated direct-Sheets-from-browser path and are NOT
# required. Leave unset unless you intentionally use that old path.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets
